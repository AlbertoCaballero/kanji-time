<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/interval_label"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/interval_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/interval_1h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_1h" />

            <RadioButton
                android:id="@+id/interval_2h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_2h" />

            <RadioButton
                android:id="@+id/interval_6h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_6h" />

            <RadioButton
                android:id="@+id/interval_12h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_12h" />

            <RadioButton
                android:id="@+id/interval_24h"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_24h" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/language_label"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/language_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/language_english"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_english" />

            <RadioButton
                android:id="@+id/language_spanish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_spanish" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/language_note"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/custom_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/custom_note"
            android:textSize="12sp" />

        <Button
            android:id="@+id/custom_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_import" />

        <EditText
            android:id="@+id/edit_kanji"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/custom_hint_kanji"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="8"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edit_reading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/custom_hint_reading"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/edit_meaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/custom_hint_meaning"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/custom_add"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/custom_add" />

        <TextView
            android:id="@+id/custom_list_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/custom_list_label"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/custom_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
